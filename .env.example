# ==============================================================================
# The Laddu Story OMS - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Google Sheets API v4 Configuration
# Path to the Google Cloud Service Account JSON credentials file
GOOGLE_APPLICATION_CREDENTIALS=./config/google-service-account.json
# Google Sheets Spreadsheet ID (generated by scripts/google-sheets-setup.js)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Meta Cloud API (WhatsApp Business & Instagram DM Webhooks)
META_VERIFY_TOKEN=the_laddu_story_secret_token_2026
META_API_VERSION=v19.0
META_ACCESS_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
INSTAGRAM_PAGE_ID=your_instagram_page_id_here

# UPI Payment Merchant Configuration
UPI_MERCHANT_VPA=theladdu@bank
UPI_MERCHANT_NAME=TheLadduStory
UPI_CURRENCY=INR

# Desktop Local SQLite Database Path
SQLITE_DB_PATH=./electron/db/laddu_oms.db

# Polling & Synchronization Timing
SYNC_POLL_INTERVAL_MS=30000
